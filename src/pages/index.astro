---
import Layout from "@/layouts/Layout.astro";
// Each panel is wrapped in its own error boundary (see components/islands).
import { Map } from "@/components/islands/Map";
import { GameDialogs } from "@/components/islands/GameDialogs";
import { PlaceReviewBar } from "@/components/islands/PlaceReviewBar";
import { PlayAreaBar } from "@/components/islands/PlayAreaBar";
import { QuestionSidebar } from "@/components/islands/QuestionSidebar";
import { AskButton, TabBar } from "@/components/islands/TabBar";
import { SidebarButton } from "@/components/SidebarButton";
import { SidebarProvider } from "@/components/ui/sidebar-l";
---

<Layout className="bg-jetlag">
    <SidebarProvider client:load>
        <QuestionSidebar client:only />
        <TabBar client:only />
        <main class="flex flex-col flex-grow">
            <div class="flex justify-center" id="map-modal-dialog-container-leaflet">
                <div class="w-full h-full relative">
                    <!-- Desktop: top left, next to the sidebar. Phones have the
                         tab bar instead. -->
                    <div
                        class="absolute z-[1030] max-md:hidden md:top-2 md:left-2"
                        data-tutorial-id="left-sidebar-trigger"
                    >
                        <SidebarButton client:load />
                    </div>
                    <div
                        class="flex flex-shrink max-w-fit z-[1030] absolute left-4 right-0 m-auto"
                    >
                        <PlayAreaBar client:only className="m-4" />
                        <PlaceReviewBar client:only className="m-4" />
                    </div>
                    <!-- The game's dialogs, and the desktop's Menu button. -->
                    <div class="absolute top-2 right-2 z-[1036]">
                        <GameDialogs client:load />
                    </div>
                    <Map className="w-full" client:only />
                    <AskButton client:only />
                </div>
            </div>
        </main>
    </SidebarProvider>
</Layout>
