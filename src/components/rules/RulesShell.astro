---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";

// Frame of the rulebook pages: back links, the contents, and the page.
export interface Props {
    title: string;
    /** Id of the page being shown (e.g. "seeking/radar-questions"). */
    current?: string;
}

const { title, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pages = (await getCollection("rules")).sort(
    (a, b) => a.data.order - b.data.order,
);
const chapters = pages.filter((page) => !page.id.includes("/"));
const index = pages.findIndex((page) => page.id === current);
const previous = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 ? pages[index + 1] : undefined;
const href = (id: string) => `${base}rules/${id}/`;
---

<Layout className="bg-slate-950 text-slate-100" title={`${title} · Hide and Seek rules`}>
    <div class="mx-auto flex max-w-5xl gap-8 px-4 py-6 font-oxygen leading-relaxed">
        <nav class="hidden w-56 shrink-0 text-sm md:block" aria-label="Rules contents">
            <a href={`${base}rules/`} class="font-semibold">Rules</a>
            <ul class="mt-2 space-y-1">
                {
                    pages.map((page) => (
                        <li class={page.id.includes("/") ? "pl-3" : "mt-2 font-semibold"}>
                            <a
                                href={href(page.id)}
                                class:list={[
                                    "hover:underline",
                                    page.id === current ? "text-blue-400" : "text-slate-300",
                                ]}
                            >
                                {page.data.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <main class="min-w-0 flex-1">
            <p class="mb-4 flex flex-wrap gap-x-4 text-sm">
                <a href={base} class="text-blue-400 underline">← Back to the map</a>
                <a href={`${base}rules/`} class="text-blue-400 underline">All rules</a>
                <a href={`${base}reference/`} class="text-blue-400 underline">Question &amp; card reference</a>
            </p>
            <details class="mb-4 md:hidden">
                <summary class="cursor-pointer text-sm text-slate-300">Contents</summary>
                <ul class="mt-2 space-y-1 text-sm">
                    {
                        chapters.map((page) => (
                            <li>
                                <a href={href(page.id)} class="text-blue-400 underline">
                                    {page.data.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </details>
            <slot />
            {
                index >= 0 && (
                    <nav class="mt-10 flex justify-between gap-4 border-t border-slate-700 pt-4 text-sm" aria-label="Previous and next page">
                        {previous ? (
                            <a href={href(previous.id)} class="text-blue-400 underline">
                                ← {previous.data.title}
                            </a>
                        ) : (
                            <span />
                        )}
                        {next && (
                            <a href={href(next.id)} class="text-right text-blue-400 underline">
                                {next.data.title} →
                            </a>
                        )}
                    </nav>
                )
            }
        </main>
    </div>
</Layout>
