# `pnpm dev` runs without the self-hosted backend (see deploy/), so point it at
# public services. These see your queries; production builds never use them.
PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
PUBLIC_DEFAULT_TILE_LAYER=osmcarto
PUBLIC_GEOCODER_URL=https://photon.komoot.io/api/
