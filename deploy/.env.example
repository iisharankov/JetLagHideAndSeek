# Copy to deploy/.env and adjust. All values shown are the defaults.

# Public address of the app (used for the web app manifest and links).
SITE_URL=https://jetlag.sharankov.com

# Where map data, databases and share links are stored (relative to deploy/).
DATA_DIR=./data

# Ports on 127.0.0.1 for the host's nginx to proxy to.
WEB_PORT=18780
API_PORT=18787
OVERPASS_PORT=18781

# Map region: Switzerland plus ~30 km (min lon, min lat, max lon, max lat),
# and basemap detail (15 = street level; the extract is ~1.5 GB).
BBOX=5.5,45.6,11.0,48.1
MAX_ZOOM=15
